# === Backend sozlamalari namunasi ===
# Ushbu faylni .env deb nusxalang va qiymatlarni to'ldiring.

# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=xxxxxxxx:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# API server porti (macOS'da 5000 AirPlay tomonidan band — 5001 ishlating)
PORT=5001

# MongoDB Atlas ulanish satri.
MONGO_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/invitationDB?retryWrites=true&w=majority

# Production domen (Vercel) — webhook, Mini App, havolalar
BASE_URL=https://invit-silk.vercel.app
API_PUBLIC_URL=https://invit-silk.vercel.app

# Admin Telegram user id (to'lovni tasdiqlash). Bir nechta: 123,456
# ID ni bilish: @userinfobot yoki botga yozib logdan
ADMIN_TELEGRAM_IDS=

# === Karta o'tkazma to'lov (Hamkorbank UZCARD) ===
# Raqam faqat raqamlar (bo'shliqsiz). Ekranda avtomatik guruhlanadi.
PAY_UZCARD_NUMBER=8600123456789012
PAY_UZCARD_HOLDER=ISM FAMILIYA

# Ixtiyoriy — alohida HUMO (bo'sh qoldirilsa UZCARD ishlatiladi)
PAY_HUMO_NUMBER=
PAY_HUMO_HOLDER=

# Sessiya muddati (daqiqa) — Verion uslubidagi timer
PAY_SESSION_MINUTES=7

# Eski sandbox (ixtiyoriy, endi asosiy oqim emas)
TEST_CARD=1234567812345678


# To'lov avtomatik tasdiq (true = admin kutmaydi; test uchun)
PAY_AUTO_CONFIRM=false
# Test rejim: summa 1..8 so'm, sinov tugmasi
PAY_TEST_MODE=false
PAY_TEST_AMOUNT_MAX=8
